<div class="news-timeline">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% if include.limit %}
      {% assign news_limit = 3 %}
    {% else %}
      {% assign news_limit = news.size %}
    {% endif %}

    <div class="timeline-list border-y border-slate-200 dark:border-slate-800 divide-y divide-slate-200 dark:divide-slate-800">
      {% for item in news limit: news_limit %}
        <article class="timeline-item py-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-3">
          <div class="timeline-body flex-1 text-xs text-slate-700 dark:text-slate-300 leading-relaxed font-sans max-w-3xl">
            {% assign badge_label = nil %}
            {% assign badge_class = "bg-blue-100 dark:bg-blue-950 text-blue-800 dark:text-blue-300 border-blue-200 dark:border-blue-800" %}
            
            {% if item.certificate_id %}
              {% if site.active_lang == 'pt-br' %}{% assign badge_label = "Certificação" %}{% else %}{% assign badge_label = "Certification" %}{% endif %}
              {% assign badge_class = "bg-blue-100 dark:bg-blue-950 text-blue-800 dark:text-blue-300 border-blue-200 dark:border-blue-800" %}
            {% elsif item.category %}
              {% assign badge_label = item.category %}
            {% elsif item.content contains 'Mestrado' or item.content contains "Master's" %}
              {% assign badge_label = "Stricto Sensu" %}
              {% assign badge_class = "bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800" %}
            {% elsif item.content contains 'MBA' %}
              {% if site.active_lang == 'pt-br' %}{% assign badge_label = "Pós-Graduação" %}{% else %}{% assign badge_label = "Graduate" %}{% endif %}
              {% assign badge_class = "bg-oxford/10 dark:bg-blue-950 text-oxford dark:text-blue-300 border-oxford/20 dark:border-blue-800" %}
            {% elsif item.content contains 'ANCORD' %}
              {% if site.active_lang == 'pt-br' %}{% assign badge_label = "Regulatório" %}{% else %}{% assign badge_label = "Regulatory" %}{% endif %}
              {% assign badge_class = "bg-purple-100 dark:bg-purple-950 text-purple-800 dark:text-purple-300 border-purple-200 dark:border-purple-800" %}
            {% endif %}

            {% if badge_label %}
              <span class="timeline-badge inline-flex items-center px-2 py-0.5 rounded font-mono text-[10px] font-bold border mr-2 align-baseline {{ badge_class }}">
                {{ badge_label }}
              </span>
            {% endif %}

            {% if item.inline %}
              <span class="news-inline-content align-baseline">{{ item.content | remove: '<p>' | remove: '</p>' | strip | emojify }}</span>
            {% else %}
              <a class="news-title font-bold text-slate-950 dark:text-white text-sm hover:text-oxford dark:hover:text-blue-400 transition text-decoration-none mr-2 align-baseline" href="{{ item.url | relative_url }}">
                {{ item.title }}
              </a>
              {% if item.description or item.summary %}
                <span class="news-desc text-slate-600 dark:text-slate-400 block sm:inline mt-1 sm:mt-0 align-baseline">{{ item.description | default: item.summary }}</span>
              {% endif %}
            {% endif %}
          </div>

          <!-- Localized Fira Code Date -->
          <span class="timeline-date font-mono text-xs font-semibold text-slate-600 dark:text-slate-400 shrink-0 sm:text-right">
            {% if site.active_lang == 'pt-br' %}
              {% assign m = item.date | date: "%m" %}
              {% assign day = item.date | date: "%d" %}
              {% assign year = item.date | date: "%Y" %}
              {% case m %}
                {% when '01' %}{% assign m_str = 'Jan' %}
                {% when '02' %}{% assign m_str = 'Fev' %}
                {% when '03' %}{% assign m_str = 'Mar' %}
                {% when '04' %}{% assign m_str = 'Abr' %}
                {% when '05' %}{% assign m_str = 'Mai' %}
                {% when '06' %}{% assign m_str = 'Jun' %}
                {% when '07' %}{% assign m_str = 'Jul' %}
                {% when '08' %}{% assign m_str = 'Ago' %}
                {% when '09' %}{% assign m_str = 'Set' %}
                {% when '10' %}{% assign m_str = 'Out' %}
                {% when '11' %}{% assign m_str = 'Nov' %}
                {% when '12' %}{% assign m_str = 'Dez' %}
              {% endcase %}
              {{ day }} {{ m_str }} {{ year }}
            {% else %}
              {{ item.date | date: '%b %d, %Y' }}
            {% endif %}
          </span>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p class="text-xs font-mono text-slate-500 py-4">{% if site.active_lang == 'pt-br' %}Nenhum comunicado no momento.{% else %}No news so far...{% endif %}</p>
  {% endif %}
</div>
