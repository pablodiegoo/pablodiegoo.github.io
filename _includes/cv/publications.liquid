<div class="divide-y divide-slate-200 dark:divide-slate-800">
  {% for pub in entry.contents %}
    <article class="py-3.5 space-y-1">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <h3 class="text-sm font-bold text-slate-950 dark:text-white font-sans m-0">
          {{ pub.title }}
        </h3>
        <span class="font-mono text-xs text-slate-500 shrink-0">{{ pub.year }}</span>
      </div>
      <div class="text-xs text-slate-600 dark:text-slate-400 font-mono">
        {% if pub.citation and pub.citation != "" %}
          <strong>{{ pub.citation }}</strong> · 
        {% endif %}
        {{ pub.venue }}
      </div>
      {% if pub.url != "" and pub.url != nil %}
        <a href="{{ pub.url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-mono text-[11px] text-oxford dark:text-blue-400 hover:underline pt-0.5">
          <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
          <span>
            {% if pub.is_repository %}
              {% if site.active_lang == 'pt-br' %}Repositório Institucional{% else %}Institutional Repository{% endif %}
            {% else %}
              {% if site.active_lang == 'pt-br' %}Artigo Online{% else %}Online Paper{% endif %}
            {% endif %}
          </span>
        </a>
      {% endif %}
    </article>
  {% endfor %}
</div>
