<div class="divide-y divide-slate-200 dark:divide-slate-800">
  {% for item in entry.contents %}
    <article class="py-4 space-y-1.5">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <div class="flex items-center gap-2">
          <h3 class="text-base font-bold text-slate-950 dark:text-white font-sans m-0">
            {% if item.jekyll_slug and item.jekyll_slug != "" %}
              <a href="{{ item.jekyll_slug | prepend: '/projects/' | append: '/' | relative_url }}" class="hover:text-oxford dark:hover:text-blue-400 transition">
                {{ item.title }}
              </a>
            {% else %}
              {{ item.title }}
            {% endif %}
          </h3>
          {% if item.status == 'proprietary_sanitized' %}
            <span class="font-mono text-[10px] font-semibold px-2 py-0.5 rounded bg-blue-50 text-blue-900 border border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-800">
              sanitized
            </span>
          {% endif %}
        </div>
        <span class="font-mono text-xs text-slate-500 shrink-0">{{ item.year }}</span>
      </div>

      {% if item.category and item.category != "" %}
        <div class="text-xs text-slate-500 font-mono">{{ item.category }}</div>
      {% endif %}

      {% if item.summary and item.summary != "" %}
        <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed text-justify m-0">{{ item.summary }}</p>
      {% endif %}

      {% if item.stack and item.stack.size > 0 %}
        <div class="flex flex-wrap gap-1.5 pt-1">
          {% for s in item.stack %}
            <span class="tech-pill">{{ s }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </article>
  {% endfor %}
</div>
