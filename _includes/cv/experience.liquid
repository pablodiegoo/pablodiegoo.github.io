<div class="divide-y divide-slate-200 dark:divide-slate-800">
  {% for item in entry.contents %}
    <article class="py-4 space-y-2">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <h3 class="text-base font-bold text-slate-950 dark:text-white font-sans m-0">
          {{ item.title }}
        </h3>
        <span class="font-mono text-xs font-semibold text-slate-600 dark:text-slate-400 shrink-0">
          {{ item.year }}
        </span>
      </div>

      <div class="text-xs text-slate-600 dark:text-slate-400 font-mono">
        <span class="font-bold text-slate-800 dark:text-slate-200">{{ item.institution }}</span>
        {% if item.location != "" and item.location != nil %}
          · {{ item.location }}
        {% endif %}
      </div>

      {% if item.bullets and item.bullets.size > 0 %}
        <ul class="text-xs text-slate-700 dark:text-slate-300 space-y-1.5 pl-4 list-disc marker:text-slate-400 m-0">
          {% for b in item.bullets %}
            <li class="leading-relaxed text-justify">{{ b }}</li>
          {% endfor %}
        </ul>
      {% elsif item.description and item.description.size > 0 %}
        <ul class="text-xs text-slate-700 dark:text-slate-300 space-y-1.5 pl-4 list-disc marker:text-slate-400 m-0">
          {% for b in item.description %}
            <li class="leading-relaxed text-justify">{{ b }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if item.stack and item.stack.size > 0 %}
        <div class="flex flex-wrap gap-1.5 pt-1">
          {% for s in item.stack %}
            <span class="tech-pill">{{ s }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </article>
  {% endfor %}
</div>
