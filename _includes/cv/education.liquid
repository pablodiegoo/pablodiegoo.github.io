<div class="divide-y divide-slate-200 dark:divide-slate-800">
  {% for item in entry.contents %}
    <article class="py-4 space-y-1.5">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <h3 class="text-base font-bold text-slate-950 dark:text-white font-sans m-0">
          {{ item.title }}
        </h3>
        <span class="font-mono text-xs font-semibold text-slate-600 dark:text-slate-400 shrink-0">
          {{ item.year }}
        </span>
      </div>

      <div class="text-xs text-slate-600 dark:text-slate-400 font-mono">
        <span class="font-bold text-slate-800 dark:text-slate-200">{{ item.institution }}</span>
        {% if item.focus != "" and item.focus != nil %}
          · {{ item.focus }}
        {% endif %}
      </div>

      <div class="text-xs text-slate-700 dark:text-slate-300 space-y-1 pt-1">
        {% if item.advisor != "" and item.advisor != nil %}
          <div>
            <strong class="font-semibold text-slate-900 dark:text-slate-100">
              {% if site.active_lang == 'pt-br' %}Orientador:{% else %}Advisor:{% endif %}
            </strong> {{ item.advisor }}
          </div>
        {% endif %}
        {% if item.thesis != "" and item.thesis != nil %}
          <div>
            <strong class="font-semibold text-slate-900 dark:text-slate-100">
              {{ item.thesis_label | default: "Dissertação" }}:
            </strong> 
            <em class="font-serif italic text-slate-800 dark:text-slate-200">{{ item.thesis }}</em>
            {% if item.thesis_url != "" and item.thesis_url != nil %}
              <a href="{{ item.thesis_url }}" target="_blank" rel="noopener noreferrer" class="text-oxford dark:text-blue-400 ml-1 font-mono text-[11px] underline">
                {% if site.active_lang == 'pt-br' %}Repositório ↗{% else %}Repository ↗{% endif %}
              </a>
            {% endif %}
          </div>
        {% endif %}
        {% if item.workload != "" and item.workload != nil %}
          <div class="font-mono text-[11px] text-slate-500">{{ item.workload }}</div>
        {% endif %}
      </div>

      {% if item.tags and item.tags.size > 0 %}
        <div class="flex flex-wrap gap-1.5 pt-1">
          {% for tag in item.tags %}
            <span class="tech-pill">{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </article>
  {% endfor %}
</div>
