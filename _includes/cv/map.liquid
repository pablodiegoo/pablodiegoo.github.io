<div class="cv-map divide-y divide-slate-200 dark:divide-slate-800 border-y border-slate-200 dark:border-slate-800 my-2">
  {% for content in entry.contents %}
    <div class="py-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 text-xs">
      <span class="font-bold text-slate-900 dark:text-slate-100 font-mono">{{ content.name }}</span>
      {% if content.value %}
        <span class="text-slate-700 dark:text-slate-300">{{ content.value }}</span>
      {% endif %}
      {% if content.links %}
        <div class="flex flex-wrap gap-1.5">
          {% for item in content.links %}
            {% if item.link %}
              <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer" class="hero-badge-pill">
                {{ item.name | default: "Link" }} ↗
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>
