<article class="project-card-wrapper w-full">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" class="project-card flex flex-col md:flex-row overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-400 dark:hover:border-slate-600 transition text-decoration-none block">
    {% if project.img %}
      <div class="project-thumbnail aspect-video md:w-2/5 overflow-hidden border-b md:border-b-0 md:border-r border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800">
        {% if site.active_lang == 'pt-br' and project.title_pt %}
          {% assign alt_title = project.title_pt | escape %}
        {% else %}
          {% assign alt_title = project.title | default: "Project thumbnail" | escape %}
        {% endif %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes="(min-width: 768px) 40vw, 100vw"
          alt=alt_title
          class="w-full h-full object-cover"
        %}
      </div>
    {% endif %}
    <div class="project-card-body p-5 flex flex-col flex-1 justify-between gap-3">
      <div class="space-y-2">
        {% if project.institution or project.period %}
          <div class="project-meta font-mono text-xs text-slate-500 dark:text-slate-400">
            {% if project.institution and project.period %}
              {{ project.institution }} // {{ project.period }}
            {% elsif project.institution %}
              {{ project.institution }}
            {% elsif project.period %}
              {{ project.period }}
            {% endif %}
          </div>
        {% endif %}

        <h3 class="project-title font-sans text-xl font-semibold tracking-tight text-slate-950 dark:text-white m-0">
          {% if site.active_lang == 'pt-br' and project.title_pt %}
            {{ project.title_pt }}
          {% else %}
            {{ project.title }}
          {% endif %}
        </h3>

        <p class="project-description text-sm text-slate-700 dark:text-slate-300 font-normal leading-relaxed m-0">
          {% if site.active_lang == 'pt-br' and project.description_pt %}
            {{ project.description_pt }}
          {% else %}
            {{ project.description }}
          {% endif %}
        </p>
      </div>

      {% assign tech_items = project.tech_stack | default: project.tags %}
      {% if tech_items and tech_items.size > 0 %}
        <div class="project-tech-stack flex flex-wrap gap-1.5 pt-1">
          {% for tech in tech_items limit: 6 %}
            <span class="tech-pill">{{ tech }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </a>
</article>
