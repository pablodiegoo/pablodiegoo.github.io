{% comment %}
  ==============================================================================
  _includes/seo/jsonld.liquid — Motor Canônico de Dados Estruturados Schema.org
  Diretrizes: CONTEXT.md e docs/adr/0002-arquitetura-entidades-semanticas-seo-tripartite.md
  Fonte de Dados: site.data.seo e site.data.profile (SSOT)
  ==============================================================================
{% endcomment %}

{% assign active_lang = site.active_lang | default: site.lang | default: 'pt-br' %}
{% if active_lang == 'en' %}
  {% assign is_en = true %}
  {% assign lang_key = 'en' %}
  {% assign ws_lang = 'en' %}
{% else %}
  {% assign is_en = false %}
  {% assign lang_key = 'pt' %}
  {% assign ws_lang = 'pt-BR' %}
{% endif %}

{% assign seo_person = nil %}
{% assign seo_fs = nil %}
{% assign seo_ws = nil %}
{% if site.data.seo and site.data.seo['@graph'] %}
  {% for node in site.data.seo['@graph'] %}
    {% if node['@type'] == 'Person' %}
      {% assign seo_person = node %}
    {% elsif node['@type'] == 'FinancialService' %}
      {% assign seo_fs = node %}
    {% elsif node['@type'] == 'WebSite' %}
      {% assign seo_ws = node %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if seo_person and seo_person['@id'] %}
  {% assign person_id = seo_person['@id'] %}
{% else %}
  {% assign person_id = site.url | append: '/#person' %}
{% endif %}

{% if seo_fs and seo_fs['@id'] %}
  {% assign fs_id = seo_fs['@id'] %}
{% else %}
  {% assign fs_id = site.url | append: '/#financial-service' %}
{% endif %}

{% if seo_ws and seo_ws['@id'] %}
  {% assign ws_id = seo_ws['@id'] %}
{% else %}
  {% assign ws_id = site.url | append: '/#website' %}
{% endif %}

{% assign person_name = site.data.profile.name.canonical | default: seo_person.name %}
{% assign person_alt_name = site.data.profile.name.commercial | default: seo_person.alternateName %}
{% assign person_job_title = seo_person.jobTitle[lang_key] | default: site.data.profile.headline[lang_key] %}
{% assign person_desc = seo_person.description[lang_key] | default: site.data.profile.summary[lang_key] %}

{% if is_en %}
  {% assign fs_name = seo_fs.alternateName | default: seo_fs.name %}
  {% assign fs_alt_name = seo_fs.name %}
  {% assign ws_name = seo_ws.alternateName | default: seo_ws.name %}
  {% assign ws_alt_name = seo_ws.name %}
  {% assign localized_site_url = site.url | append: site.baseurl | append: '/en/' %}
{% else %}
  {% assign fs_name = seo_fs.name %}
  {% assign fs_alt_name = seo_fs.alternateName %}
  {% assign ws_name = seo_ws.name %}
  {% assign ws_alt_name = seo_ws.alternateName %}
  {% assign localized_site_url = site.url | append: site.baseurl | append: '/' %}
{% endif %}

{% assign fs_service_type = seo_fs.serviceType[lang_key] %}
{% assign fs_desc = seo_fs.description[lang_key] %}
{% assign ws_desc = seo_ws.description[lang_key] %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": {{ person_id | jsonify }},
      "name": {{ person_name | jsonify }},
      "alternateName": {{ person_alt_name | jsonify }},
      "jobTitle": {{ person_job_title | jsonify }},
      "description": {{ person_desc | jsonify }},
      "url": {{ localized_site_url | jsonify }},
      "sameAs": {{ seo_person.sameAs | jsonify }},
      "hasOccupation": [
        {% for occ in seo_person.hasOccupation %}
          {
            "@type": "Occupation",
            {% if is_en %}
              "name": {{ occ.name.en | default: occ.name.pt | jsonify }},
              "description": {{ occ.description.en | default: occ.description.pt | jsonify }}
            {% else %}
              "name": {{ occ.name.pt | default: occ.name.en | jsonify }},
              "description": {{ occ.description.pt | default: occ.description.en | jsonify }}
            {% endif %}
            {% if occ.occupationalCategory %}, "occupationalCategory": {{ occ.occupationalCategory | jsonify }}{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "hasCredential": [
        {% for cred in seo_person.hasCredential %}
          {
            "@type": {{ cred["@type"] | default: "EducationalOccupationalCredential" | jsonify }},
            {% if is_en %}
              "name": {{ cred.name.en | default: cred.name.pt | jsonify }},
            {% else %}
              "name": {{ cred.name.pt | default: cred.name.en | jsonify }},
            {% endif %}
            "credentialCategory": {{ cred.credentialCategory | jsonify }}
            {% if cred.credentialId %}, "credentialId": {{ cred.credentialId | jsonify }}{% endif %}
            {% if cred.educationalLevel %}, "educationalLevel": {{ cred.educationalLevel | jsonify }}{% endif %}
            {% if cred.recognizedBy %}
              , "recognizedBy": {
                "@type": {{ cred.recognizedBy["@type"] | jsonify }},
                "name": {{ cred.recognizedBy.name | jsonify }}
                {% if cred.recognizedBy.alternateName %}, "alternateName": {{ cred.recognizedBy.alternateName | jsonify }}{% endif %}
                {% if cred.recognizedBy.sameAs %}, "sameAs": {{ cred.recognizedBy.sameAs | jsonify }}{% endif %}
                {% if cred.recognizedBy.url %}, "url": {{ cred.recognizedBy.url | jsonify }}{% endif %}
              }
            {% endif %}
            {% if cred.validIn %}
              , "validIn": {
                "@type": {{ cred.validIn["@type"] | jsonify }},
                "name": {{ cred.validIn.name | jsonify }}
                {% if cred.validIn.sameAs %}, "sameAs": {{ cred.validIn.sameAs | jsonify }}{% endif %}
              }
            {% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "knowsAbout": [
        {% for item in seo_person.knowsAbout %}
          {% if item["@id"] %}
            {
              "@type": "DefinedTerm",
              "@id": {{ item["@id"] | jsonify }},
              {% if is_en %}
                "name": {{ item.name | jsonify }}
              {% else %}
                "name": {{ item.name_pt | default: item.name | jsonify }}
              {% endif %}
            }
          {% else %}
            {{ item | jsonify }}
          {% endif %}{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    },
    {
      "@type": "FinancialService",
      "@id": {{ fs_id | jsonify }},
      "name": {{ fs_name | jsonify }},
      "alternateName": {{ fs_alt_name | jsonify }},
      "provider": {
        "@id": {{ person_id | jsonify }}
      },
      "serviceType": {{ fs_service_type | jsonify }},
      "description": {{ fs_desc | jsonify }},
      "url": {{ localized_site_url | jsonify }},
      "areaServed": [
        {% for area in seo_fs.areaServed %}
          {
            "@type": {{ area["@type"] | jsonify }},
            {% if is_en and area.alternateName %}
              "name": {{ area.alternateName | jsonify }},
              "alternateName": {{ area.name | jsonify }}
            {% else %}
              "name": {{ area.name | jsonify }}
              {% if area.alternateName %}, "alternateName": {{ area.alternateName | jsonify }}{% endif %}
            {% endif %}
            {% if area.sameAs %}, "sameAs": {{ area.sameAs | jsonify }}{% endif %}
            {% if area.addressRegion %}, "addressRegion": {{ area.addressRegion | jsonify }}{% endif %}
            {% if area.addressCountry %}, "addressCountry": {{ area.addressCountry | jsonify }}{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    },
    {
      "@type": "WebSite",
      "@id": {{ ws_id | jsonify }},
      "name": {{ ws_name | jsonify }},
      "alternateName": {{ ws_alt_name | jsonify }},
      "url": {{ localized_site_url | jsonify }},
      "inLanguage": {{ ws_lang | jsonify }},
      "author": {
        "@id": {{ person_id | jsonify }}
      },
      "publisher": {
        "@id": {{ person_id | jsonify }}
      },
      "description": {{ ws_desc | jsonify }}
    }
  ]
}
</script>
