@article{pereira2026pairtrading_revistaes,
  abbr={Rev. E&S},
  bibtex_show={true},
  title={Pair Trading com Machine Learning no Mercado Brasileiro: uma Comparação com a Abordagem Clássica de Cointegração},
  author={Pereira, Pablo Diego de Albuquerque and Santos, Diego Pedroso dos},
  journal={Revista Estratégias e Soluções},
  issn={2675-6528},
  publisher=pecege,
  year={2026},
  month={9},
  doi={10.22167/2675-6528-202602302},
  url={https://revistaes.com.br/artigos/pair-trading-com-machine-learning-no-mercado-brasileiro-uma-comparacao-com-a-abordagem-classica-de-cointegracao},
  html={https://revistaes.com.br/artigos/pair-trading-com-machine-learning-no-mercado-brasileiro-uma-comparacao-com-a-abordagem-classica-de-cointegracao},
  dimensions={true},
  preview={pairtrading_dbscan.png},
  selected={true},
  abstract={A arbitragem estatística via Pairs Trading é uma estratégia consolidada na gestão quantitativa de portfólios. Investigou-se a aplicação de Machine Learning não supervisionado para seleção de pares de ativos, comparando seu desempenho com a abordagem clássica de Cointegração no mercado financeiro brasileiro. Dados históricos da B3, de 2004 a 2025, foram coletados e processados por validação walk-forward. A metodologia de Machine Learning combinou Análise de Componentes Principais (PCA) e o algoritmo DBSCAN para identificar clusters de ativos, enquanto a abordagem Baseline utilizou a Cointegração Clássica setorial. Testes T de Welch e de Levene foram aplicados para inferência estatística. Os resultados indicaram que, embora a diferença nos retornos médios diários não tenha sido estatisticamente significativa (p = 0,656), a estratégia de Machine Learning alcançou retorno acumulado superior (202,48% vs. 157,24%) e menor volatilidade anualizada (4,29% vs. 4,62%) em comparação com a Baseline. O Teste de Levene sugeriu uma tendência de redução de risco (p = 0,066) pela abordagem de Machine Learning. Concluiu-se que o pipeline de Machine Learning aprimorou a qualidade dos pares selecionados, resultando em um portfólio com menor volatilidade e maior retorno acumulado em horizontes longos, sem necessariamente prever retornos superiores em termos estatísticos diários.}
}

