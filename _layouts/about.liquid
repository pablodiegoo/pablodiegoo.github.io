---
layout: default
---
<div class="post about-l2">
  <!-- Hero L2 Header -->
  <header class="hero-l2 border-b border-slate-200 dark:border-slate-800 pb-8 mb-8">
    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8">
      {% if page.profile and page.profile.image %}
        <div class="profile-column flex flex-col items-center shrink-0 w-36 sm:w-44 text-center">
          <div class="profile-photo-container w-32 h-32 sm:w-36 sm:h-36 rounded-full overflow-hidden shrink-0 ring-2 ring-slate-300 dark:ring-slate-700 shadow-sm aspect-square">
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% capture sizes %}(min-width: 640px) 144px, 128px{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class="w-full h-full object-cover rounded-full" sizes=sizes alt="Pablo Diego Pereira"
              cache_bust=true
            %}
          </div>

          {% assign quote_text = nil %}
          {% if site.active_lang == 'pt-br' %}
            {% assign quote_text = site.data.profile.quote.text.pt | default: page.profile.more_info_pt | default: page.profile.quote_pt | default: page.profile.more_info | default: page.profile.quote %}
          {% else %}
            {% assign quote_text = site.data.profile.quote.text.en | default: page.profile.more_info_en | default: page.profile.quote_en | default: page.profile.more_info | default: page.profile.quote %}
          {% endif %}
          {% assign quote_author = site.data.profile.quote.author | default: page.profile.quote_author | default: "Viktor Frankl" %}
          {% if quote_text %}
            <div class="hero-quote mt-3 text-center max-w-[160px] sm:max-w-[176px]">
              <blockquote class="italic text-xs text-slate-600 dark:text-slate-400 leading-snug m-0">
                {{ quote_text }}
              </blockquote>
              <div class="quote-author text-[11px] font-medium text-slate-700 dark:text-slate-300 mt-1">
                — {{ quote_author }}
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div class="hero-details space-y-2 text-center sm:text-left flex-1">
        <h1 class="post-title font-serif text-4xl sm:text-5xl tracking-tight text-slate-950 dark:text-white leading-tight">
          <span class="font-bold">{{ site.first_name | default: "Pablo Diego" }}</span> <span class="font-normal text-slate-800 dark:text-slate-200">{{ site.last_name | default: "Pereira" }}</span>
        </h1>

        <p class="hero-degrees text-base text-slate-700 dark:text-slate-300 font-normal leading-relaxed mt-2">
          {% if site.active_lang == 'pt-br' %}
            {{ page.subtitle_pt | default: page.subtitle }}
          {% else %}
            {{ page.subtitle_en | default: page.subtitle }}
          {% endif %}
        </p>

        <div class="hero-citation font-mono text-xs text-slate-600 dark:text-slate-400 font-semibold pt-1">
          {% if site.active_lang == 'en' %}
            CITATION: <span class="text-slate-900 dark:text-slate-100 font-bold">PEREIRA, P. D. A.</span> · Pablo Diego de Albuquerque Pereira · Rio de Janeiro, Brazil
          {% else %}
            CITAÇÃO: <span class="text-slate-900 dark:text-slate-100 font-bold">PEREIRA, P. D. A.</span> · Pablo Diego de Albuquerque Pereira · Rio de Janeiro, Brasil
          {% endif %}
        </div>

        <!-- Dynamic Academic & Professional Identifier Badges (SSOT) -->
        {% assign lattes_id = site.data.socials.lattes_id | default: site.lattes_id %}
        {% assign orcid_id = site.data.socials.orcid_id | default: site.orcid_id %}
        {% assign github_id = site.data.socials.github_username | default: site.github_username %}
        {% assign linkedin_id = site.data.socials.linkedin_username | default: site.linkedin_username %}

        <div class="hero-badges flex flex-wrap gap-2 pt-3 font-mono text-xs font-semibold justify-center sm:justify-start">
          {% if lattes_id %}
            <a href="http://lattes.cnpq.br/{{ lattes_id }}" target="_blank" rel="noopener noreferrer" class="hero-badge-pill">
              Lattes ↗
            </a>
          {% endif %}
          {% if orcid_id %}
            <a href="https://orcid.org/{{ orcid_id }}" target="_blank" rel="noopener noreferrer" class="hero-badge-pill">
              ORCID ↗
            </a>
          {% endif %}
          {% if github_id %}
            <a href="https://github.com/{{ github_id }}" target="_blank" rel="noopener noreferrer" class="hero-badge-pill">
              GitHub ↗
            </a>
          {% endif %}
          {% if linkedin_id %}
            <a href="https://www.linkedin.com/in/{{ linkedin_id }}/" target="_blank" rel="noopener noreferrer" class="hero-badge-pill">
              LinkedIn ↗
            </a>
          {% endif %}
        </div>

      </div>
    </div>
  </header>

  <article>
    <!-- Biography / Main Narrative -->
    <div class="clearfix text-base leading-relaxed text-slate-800 dark:text-slate-200 mb-8 text-justify">
      {{ content }}
    </div>

    <!-- Trajectory & Affiliations Section -->
    {% if site.data.affiliations %}
      <section class="trajectory-section space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800 mb-8">
        <h2 class="font-serif text-2xl font-bold text-slate-950 dark:text-white flex items-center justify-between">
          <span>
            {% if site.active_lang == 'pt-br' %}Trajetória Acadêmica &amp; Mercado{% else %}Academic &amp; Professional Trajectory{% endif %}
          </span>
          <span class="font-mono text-xs text-slate-600 dark:text-slate-400 uppercase font-normal">
            {% if site.active_lang == 'pt-br' %}Marcos Principais{% else %}Key Milestones{% endif %}
          </span>
        </h2>

        <div class="trajectory-list divide-y divide-slate-200 dark:divide-slate-800 border-y border-slate-200 dark:border-slate-800">
          {% for affiliation in site.data.affiliations %}
            <div class="py-3.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
              <div>
                <div class="font-bold text-slate-950 dark:text-white text-sm">
                  {% if site.active_lang == 'pt-br' %}{{ affiliation.role.pt }}{% else %}{{ affiliation.role.en }}{% endif %}
                </div>
                <div class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">
                  {{ affiliation.org }} · <span class="font-mono text-slate-700 dark:text-slate-300 font-semibold">{% if site.active_lang == 'pt-br' %}{{ affiliation.focus.pt }}{% else %}{{ affiliation.focus.en }}{% endif %}</span>
                </div>
              </div>
              <span class="font-mono text-xs font-semibold text-slate-600 dark:text-slate-300 shrink-0">
                {% if site.active_lang == 'pt-br' %}{{ affiliation.period }}{% else %}{{ affiliation.period_en }}{% endif %}
              </span>
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <!-- Featured Projects Showcase Section -->
    {% assign sanitized_projects = site.projects | where: "confidentiality", "proprietary_sanitized" | sort: "importance" %}
    <section class="featured-projects space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800 mb-8">
      <div class="flex justify-between items-baseline">
        <h2 class="font-serif text-2xl font-bold text-slate-950 dark:text-white">
          {% if site.active_lang == 'pt-br' %}Projetos em Destaque{% else %}Featured Projects{% endif %}
        </h2>
        <a href="{{ '/projects/' | relative_url }}" class="cta-catalog-btn font-mono text-xs font-semibold px-3 py-1.5 rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 hover:border-slate-400 dark:hover:border-slate-600 transition inline-flex items-center gap-1 text-decoration-none">
          {% if site.active_lang == 'pt-br' %}Ver catálogo completo &rarr;{% else %}View full catalog &rarr;{% endif %}
        </a>
      </div>

      <div class="space-y-4">
        {% for project in sanitized_projects limit: 2 %}
          <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" class="project-card p-5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600 transition space-y-2 block text-decoration-none">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <h3 class="font-serif text-xl font-bold text-slate-950 dark:text-white m-0">
                {% if site.active_lang == 'pt-br' and project.title_pt %}
                  {{ project.title_pt }}
                {% else %}
                  {{ project.title }}
                {% endif %}
              </h3>
              {% assign conf = project.confidentiality | default: project.confidentiality_level %}
              {% if conf %}
                <span class="badge-status badge-{{ conf }} shrink-0">
                  {{ conf }}
                </span>
              {% endif %}
            </div>

            <p class="text-sm text-slate-700 dark:text-slate-300 font-normal leading-relaxed m-0">
              {% if site.active_lang == 'pt-br' and project.description_pt %}
                {{ project.description_pt }}
              {% else %}
                {{ project.description }}
              {% endif %}
            </p>

            {% assign tech_items = project.tech_stack | default: project.tags %}
            {% if tech_items and tech_items.size > 0 %}
              <div class="flex flex-wrap gap-1.5 pt-1">
                {% for tech in tech_items limit: 5 %}
                  <span class="tech-pill">{{ tech }}</span>
                {% endfor %}
              </div>
            {% endif %}
          </a>
        {% endfor %}
      </div>
    </section>

    <!-- Social & Contact Footer Block -->
    {% if page.social %}
      <div class="footer-social pt-8 mt-12 mb-6 border-t border-slate-200 dark:border-slate-800 text-center">
        <div class="contact-icons flex items-center justify-center gap-4 text-[1.3rem] mb-3">
          {% social_links %}
        </div>
        <div class="contact-note text-xs text-slate-600 dark:text-slate-400 max-w-md mx-auto">
          {% if site.active_lang == 'pt-br' %}WhatsApp é a forma mais rápida de contato direto.{% else %}WhatsApp is the fastest way to reach me directly.{% endif %}
        </div>
      </div>
    {% endif %}
  </article>
</div>
