---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% assign conf = page.confidentiality | default: page.confidentiality_level %}
  {% comment %} badge-status encapsulated in page_header.liquid {% endcomment %}
  {% include page_header.liquid badge=conf badge_class="badge-status" %}

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>{% if site.active_lang == 'pt-br' %}Referências{% else %}References{% endif %}</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.plugins contains 'al_comments' %}
    {% include plugins/al_comments.liquid %}
  {% endif %}
</div>
